{
  "version": 2,
  "builds": [
    {
      "src": "student-report-app/backend/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "student-report-app/frontend/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "student-report-app/backend/app.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "student-report-app/frontend/$1"
    }
  ]
}
